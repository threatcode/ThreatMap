{
  "name": "@threatmap/compare",
  "version": "0.0.0",
  "description": "Specification for the ThreatMap Compare plugin",
  "author": "ThreatCode",
  "repository": "https://github.com/threatcode/threatmap",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./ui": {
      "types": "./dist/ui/index.d.mts",
      "import": "./dist/ui/index.mjs",
      "default": "./dist/ui/index.mjs"
    },
    "./backend": {
      "types": "./dist/backend/index.d.mts",
      "import": "./dist/backend/index.mjs",
      "default": "./dist/backend/index.mjs"
    },
    "./frontend": {
      "types": "./dist/frontend/index.d.mts",
      "import": "./dist/frontend/index.mjs",
      "default": "./dist/frontend/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "prepare": "pnpm run build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@threatmap/sdk-shared": "workspace:*",
    "zod": "4.3.6",
    "@threatmap/sdk-frontend": "workspace:*",
    "primevue": "4.1.0",
    "vue": "3.4.33",
    "@threatmap/sdk-backend": "workspace:*"
  },
  "devDependencies": {
    "tsdown": "0.20.1"
  }
}
